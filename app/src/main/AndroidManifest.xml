<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- One-shot wifi/cellular sample on device registration (normal perm, no prompt). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- A ringing Live invite (feature/live/LiveInviteNotifications.kt):
         VIBRATE for the full-screen invite's own repeating buzz (a normal
         permission, no prompt); USE_FULL_SCREEN_INTENT to take over a locked
         or sleeping screen. The latter is granted at install up to Android
         13, but from Android 14 Google Play grants it by default only to
         calling and alarm apps — elsewhere it is off until the member turns
         it on, and the invite rings as a heads-up notification instead.
         Play Console asks for a declaration of its use at upload. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Nuru Radio keeps playing when the screen closes / phone locks. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Broadcast Studio (Nuru Live) — the broadcast must survive
         navigation/backgrounding/lock, so LiveBroadcastService runs as a
         typed foreground service for the whole life of a broadcast. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <!-- Package-visibility (Android 11+, targetSdk 36): without this, binding
         the system TextToSpeech engine for the spoken-liturgy control
         silently fails to find any engine on-device (LiturgyVoice.kt). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:name=".NuruApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.NuruMember"
        android:networkSecurityConfig="@xml/network_security_config">
        <!-- Barcode scanning moved to the Play-services (unbundled) artifact
             2026-09-16: the 4.7 MB per-ABI model no longer ships inside the app;
             this asks Play services to download it at install time so the first
             check-in scan does not wait. -->
        <meta-data android:name="com.google.mlkit.vision.DEPENDENCIES" android:value="barcode" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.NuruMember.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
            <!-- Read with a Friend (docs/READING_SOCIAL_PLAN.md §5 tier 2/3):
                 the public /join/{token} landing page's inline script attempts
                 nuru://join/{token} before falling back to the Play Store. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="nuru" android:host="join" />
            </intent-filter>
            <!-- Verified Android App Link: https://pathway.nuruplace.org/join/{token}
                 opens straight into the app once the OS has checked
                 /.well-known/assetlinks.json (hosted 2026-09-16). A SEPARATE
                 filter from the custom scheme on purpose — an autoVerify filter
                 that also lists a non-http scheme fails verification wholesale. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="pathway.nuruplace.org" android:pathPrefix="/join/" />
            </intent-filter>
        </activity>

        <!-- FCM push (§D-M9) — token → POST /me/devices; local notification on receive. -->
        <service
            android:name=".data.firebase.NuruMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <!-- Where a push the system shows lands if it names no channel, or
             one this phone doesn't have yet (data/firebase/NotificationChannels.kt). -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="nuru_updates" />

        <!-- The ringing Live invite, full screen, over the lock screen
             (feature/live/IncomingInviteActivity.kt). Not exported: only the
             invite's own notification reaches it. Its own task, out of
             Recents, so a phone woken by an invite doesn't bring the whole
             app up behind the lock screen; handles rotation itself, so a
             turn of the phone never restarts the ring. showWhenLocked /
             turnScreenOn here too (Android 8.1+; the activity also sets them
             in code, and window flags on 8.0), so the lock screen's own
             notification taps open it over the lock rather than behind it. -->
        <activity
            android:name=".feature.live.IncomingInviteActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:launchMode="singleTop"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density"
            android:theme="@style/Theme.NuruMember.Invite"
            tools:targetApi="o_mr1" />

        <!-- "Not now" / "Decline" from the tray, and the ring's end. -->
        <receiver
            android:name=".feature.live.LiveInviteReceiver"
            android:exported="false" />

        <!-- Nuru Radio background playback — Media3 foreground media service. -->
        <service
            android:name=".feature.radio.RadioService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- Broadcast Studio — owns the RootEncoder engine for the whole
             life of a broadcast so it survives navigation/backgrounding/
             lock (see LiveBroadcastService.kt's header comment). Declares
             the superset of types it may need across a session (plain
             camera broadcast, or a mid-broadcast switch to screen/document
             share); the actual runtime type passed to startForeground()
             narrows to whichever of these is genuinely active. -->
        <service
            android:name=".feature.live.LiveBroadcastService"
            android:exported="false"
            android:foregroundServiceType="camera|microphone|mediaProjection" />

        <!-- Home-screen widgets (Pathway + Radio, Jetpack Glance). Both are
             pure read-only renderers of WidgetSnapshotStore — no network,
             no exported surface. -->
        <receiver
            android:name=".widget.PathwayWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_pathway_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/pathway_widget_info" />
        </receiver>
        <receiver
            android:name=".widget.RadioWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_radio_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/radio_widget_info" />
        </receiver>

        <!-- Shares authed-downloaded files (certificate PDFs) with viewer apps. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
