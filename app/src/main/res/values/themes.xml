<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Pure-Compose app: the XML theme only styles the window before
         setContent runs. Parent on a platform theme so we don't need the XML
         Material-Components library. Warm-paper window avoids a white flash;
         system bars are managed at runtime by enableEdgeToEdge() (Android 15
         deprecates statusBarColor — never hard-set it here). -->
    <style name="Theme.NuruMember" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/nuru_paper</item>
    </style>

    <!-- The ringing Live invite (IncomingInviteActivity): a navy window, so
         a phone woken by the invite never flashes paper before it draws. -->
    <style name="Theme.NuruMember.Invite" parent="Theme.NuruMember">
        <item name="android:windowBackground">@color/nuru_live_navy</item>
    </style>

    <!-- Cold-start splash (SplashScreen compat): the round TGNM mark on the
         app's own paper, then a clean hand-off into the app. One UI, HiOS and
         stock Android each render this with their native splash motion.
         Final walk C15 (Android #28): it was a blank #E5DEDA — the launcher
         icon's tone, not paper, and no mark. The mark is asked for on every
         start (icon_preferred, API 33+): left to the platform, a start from
         Recents or a notification gets the solid colour alone. -->
    <style name="Theme.NuruMember.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/nuru_paper</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="windowSplashScreenAnimationDuration">400</item>
        <item name="android:windowSplashScreenBehavior" tools:targetApi="33">icon_preferred</item>
        <item name="postSplashScreenTheme">@style/Theme.NuruMember</item>
    </style>
</resources>
